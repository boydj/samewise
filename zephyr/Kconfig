menu "Pocket WX Radio"

config WX_SAME
	bool "SAME decoder and header parser"
	help
	  Streaming SAME decoder (services/same). Plain C99.

config WX_MATCH
	bool "Event table, matcher, filter and duplicates"
	help
	  services/match. Plain C99.

config WX_BLE_CODEC
	bool "Bluetooth value codec and time zones"
	select WX_MATCH
	select WX_SAME
	help
	  services/ble codec and POSIX TZ parser. Plain C99.

config WX_BLE_SERVICE
	bool "Bluetooth settings service and connection policy"
	select WX_BLE_CODEC
	select WX_POWER
	help
	  services/ble/ble_service.c: characteristics and policy over a port
	  table, so it runs on native_sim without a controller.

config WX_BLE_ZEPHYR
	bool "Bluetooth service on Zephyr's Bluetooth host"
	depends on BT_PERIPHERAL && BT_SMP
	select WX_BLE_SERVICE
	select BT_GATT_DYNAMIC_DB
	select BT_SMP_APP_PAIRING_ACCEPT
	select BT_SMP_SC_ONLY
	select BT_FILTER_ACCEPT_LIST
	select BT_KEYS_OVERWRITE_OLDEST
	help
	  services/ble/ble_zephyr.c: the GATT service from gatt_table.h with
	  LE Secure Connections permissions, the filter accept list and
	  display-only passkey pairing. Set BT_MAX_PAIRED=2, BT_MAX_CONN=1 and
	  BT_ATT_PREPARE_COUNT=6 (long writes at the minimum MTU).

config WX_POWER
	bool "Power manager"
	help
	  services/power: 32 MHz crystal requests.

config WX_APP_LOGIC
	bool "Application logic: settings, alert manager, health supervisor"
	select WX_SAME
	select WX_MATCH
	select WX_BLE_SERVICE

menu "native_sim fakes"
	depends on ARCH_POSIX

config WX_FAKE_AUDIO_IN
	bool "audio_in fake: WAV file reader"
	select WX_FAKE_HOST_FILE

config WX_FAKE_CLOCK
	bool "clock fake: simulated time"

config WX_FAKE_WATCHDOG
	bool "watchdog fake: starvation triggers a simulated reset"
	help
	  Uses hal/clock.h timers, so starvation happens in simulated time.

config WX_FAKE_STORAGE
	bool "storage fake: records in memory, surviving simulated resets"

config WX_FAKE_ALERT_OUT
	bool "alert_out fake: timestamped log of buzzer, vibration and LED"

config WX_FAKE_AUDIO_OUT
	bool "audio_out fake: amplifier and routing state"

config WX_FAKE_INPUT
	bool "input fake: scripted key, lock and headphone events"

config WX_FAKE_TUNER
	bool "tuner fake: scripted signal and faults, records calls"

config WX_FAKE_BATTERY
	bool "battery fake: scripted discharge curve, records ship mode"

config WX_FAKE_HOST_FILE
	bool "Host file access for fakes and tests"
	help
	  Small shim over the host C library (open, read, write, close),
	  built into the native simulator runner.

endmenu

endmenu
